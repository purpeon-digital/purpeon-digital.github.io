// Cloudflare Workers static assets — staging previews now, production after
// the Phase 4 cutover. Deployed from GitHub Actions; see .github/workflows.
{
  "name": "purpeon-com",
  "compatibility_date": "2026-08-01",
  "routes": [{ "pattern": "www.purpeon.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash"
  }
}
